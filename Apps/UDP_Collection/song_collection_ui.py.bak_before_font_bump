            fg_color=PANEL,
            border_color=BORDER,
            border_width=0,
            corner_radius=12,
        )

    def _section_label(self, parent: Any, text: str) -> ctk.CTkLabel:
        return ctk.CTkLabel(
            parent,
            text=text,
            text_color=MUTED,
